<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Alternativa al toggle "Run server on login" de LM Studio.
  Es un AGENT, no un Daemon: Metal exige sesion grafica de usuario.
  Llama a 20-serve.sh, que espera al tailnet y ata el servidor a esa IP
  (el toggle de la GUI solo sabe hacer 0.0.0.0, abierto a la LAN).
  Destino: ~/Library/LaunchAgents/local.lmstudio.plist
  Sustituir USUARIO por la salida de `whoami` (lo hace 10-harden.sh).
-->
<plist version="1.0"><dict>
  <key>Label</key><string>local.lmstudio</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USUARIO/repositories/llm-lab/mac/scripts/20-serve.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/lmstudio-serve.log</string>
  <key>StandardErrorPath</key><string>/tmp/lmstudio-serve.log</string>
</dict></plist>
